      "id": "073d8160-6ef4-5d37-8280-26caca3c997c",
      "name": "Collect inserted",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        2080,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// One aggregated item in. Compute the new cursor from the events fetched in this run.\nconst events = $('Split events').all().map(i => i.json);\nconst inserted = $input.first().json.data || [];\nconst ids = events.map(e => Number(e.id)).filter(n => Number.isFinite(n));\nconst prev = Number($('Read cursor').first().json.cursor || 0);\nreturn [{ json: {\n  source: 'mock-api-events',\n  previous_cursor: prev,\n  cursor: ids.length ? Math.max(...ids) : prev,\n  fetched: events.length,\n  stored: inserted.filter(r => r && r.id !== undefined).length,\n  last_run_at: new Date().toISOString(),\n}}];"
      },
      "id": "02e9a528-fdd2-50a3-bef7-2f3a7b1c474b",
      "name": "Summarize run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2340,
        0
      ]
    },
    {
      "parameters": {
        "operation": "set",
        "key": "t03:events:cursor",
        "value": "={{ String($json.cursor) }}",
        "keyType": "string"
      },
      "id": "936eb1cf-2fcc-5883-bf1c-0a26b57fa71d",
      "name": "Advance cursor",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        2600,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 500,
      "credentials": {
