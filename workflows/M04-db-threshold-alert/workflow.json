      "id": "508db2fb-d178-5f9c-af48-5fc853f2f840",
      "name": "Thresholds",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        0
      ],
      "notes": "Limits live here, not in the SQL. window_key = current hour -> one alert per metric per hour.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n  (select count(*) from orders where status = 'pending')::int as pending_orders,\n  (select coalesce(round(extract(epoch from (now() - min(ordered_at))) / 3600), 0)\n     from orders where status = 'pending')::int as pending_age_hours,\n  (select count(*) from tickets\n     where status in ('open', 'triaged', 'in_progress') and priority = 'urgent')::int as open_tickets_urgent,\n  (select count(*) from tickets\n     where status in ('open', 'triaged', 'in_progress') and sla_due_at < now())::int as sla_breached,\n  now() as checked_at",
        "options": {}
      },
      "id": "4ce92871-a2ff-571d-8013-f74933f21dd4",
      "name": "Current values",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        520,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "ALcredPostgresDm",
          "name": "Postgres - demo"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// One row of current values in, one item out: every metric with its limit, plus the list of breaches.\nconst v = $input.first().json;\nconst t = $('Thresholds').first().json;\nconst defs = [\n  { metric: 'pending_orders',      label: 'Pending orders',               value: v.pending_orders,      threshold: t.pending_orders_max,      severity: 'warning' },\n  { metric: 'pending_age_hours',   label: 'Oldest pending order (hours)', value: v.pending_age_hours,   threshold: t.pending_age_hours_max,   severity: 'warning' },\n  { metric: 'open_tickets_urgent', label: 'Open urgent tickets',          value: v.open_tickets_urgent, threshold: t.open_tickets_urgent_max, severity: 'error' },\n  { metric: 'sla_breached',        label: 'Open tickets past SLA',        value: v.sla_breached,        threshold: t.sla_breached_max,        severity: 'error' },\n];\nconst metrics = defs.map(d => ({ ...d, value: Number(d.value ?? 0), threshold: Number(d.threshold),\n                                 breached: Number(d.value ?? 0) > Number(d.threshold) }));\nconst breached = metrics.filter(m => m.breached);\nconst summary = metrics.map(m => `${m.metric} ${m.value}/${m.threshold}${m.breached ? '!' : ''}`).join(', ');\nreturn [{ json: { checked_at: v.checked_at, any_breached: breached.length > 0, breached, metrics, summary } }];"
      },
      "id": "825f669f-6af8-5822-8a04-b37309acf1f4",
      "name": "Compare with thresholds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
