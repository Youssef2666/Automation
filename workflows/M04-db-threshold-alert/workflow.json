              "id": "e134dfe8-24df-5706-bb29-4af054fb3820",
              "leftValue": "={{ $json.any_breached }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
