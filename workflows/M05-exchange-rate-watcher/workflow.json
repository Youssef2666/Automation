    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select distinct on (quote) quote, rate::float as rate, fetched_at from rate_history where base = 'USD' order by quote, fetched_at desc",
        "options": {}
      },
      "id": "4937b087-7e9e-558b-ae9a-23389d737c83",
      "name": "Last stored rate per quote",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1300,
        220
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "ALcredPostgresDm",
          "name": "Postgres - demo"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Latest rates (P02 result) vs the last stored rate per quote.\nconst cfg = $('Config').first().json;\nconst res = $('Fetch rates (P02)').first().json;\nconst latest = (res.data && res.data.rates) || {};\nconst fetchedAt = (res.data && res.data.date) || new Date().toISOString();\nconst last = {};\nfor (const it of $input.all()) if (it.json.quote) last[it.json.quote] = Number(it.json.rate);\nconst watch = String(cfg.quotes || '').split(',').map(s => s.trim().toUpperCase()).filter(Boolean);\nconst out = [];\nfor (const q of watch) {\n  const rate = Number(latest[q]);\n  if (!Number.isFinite(rate)) continue;\n  const prev = last[q];\n  const change = prev ? ((rate - prev) / prev) * 100 : 0;\n  out.push({ json: { base: 'USD', quote: q, rate, previous: prev ?? null,\n                     change_pct: Math.round(change * 1000) / 1000, fetched_at: fetchedAt,\n                     alert: prev !== undefined && Math.abs(change) >= Number(cfg.threshold_pct),\n                     direction: change > 0 ? 'up' : change < 0 ? 'down' : 'flat' } });\n}\nreturn out;"
      },
      "id": "063abb7b-9d05-57eb-998a-1aad7908c6b4",
      "name": "Compare with history",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
