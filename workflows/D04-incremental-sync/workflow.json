    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO products_mirror (id, sku, name, price, stock, content_hash, synced_at)\nVALUES ($1::int, $2, $3, $4::numeric, $5::int, $6, now())\nON CONFLICT (id) DO UPDATE\n   SET sku = EXCLUDED.sku, name = EXCLUDED.name, price = EXCLUDED.price, stock = EXCLUDED.stock,\n       content_hash = EXCLUDED.content_hash, synced_at = now()\n WHERE products_mirror.content_hash IS DISTINCT FROM EXCLUDED.content_hash\nRETURNING id, sku, content_hash, (xmax = 0) AS inserted",
        "options": {
          "queryReplacement": "={{ $json.id }}, {{ $json.sku }}, {{ $json.name }}, {{ $json.price }}, {{ $json.stock }}, {{ $json.content_hash }}"
        }
      },
      "id": "123fc3ca-2a07-530b-a8a8-27fd0a4824cf",
      "name": "Upsert if changed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2600,
        0
      ],
      "notes": "ON CONFLICT ... WHERE content_hash IS DISTINCT FROM EXCLUDED.content_hash: unchanged rows return no row (skipped). P03 variant: the upsert is the guard.",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "ALcredPostgresDm",
          "name": "Postgres - demo"
        }
      }
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "data",
        "options": {}
      },
      "id": "3f13d80c-2808-542b-a38b-e7744e9e4a15",
      "name": "Collect results",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        2860,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// One aggregated item in: the RETURNING rows of \"Upsert if changed\" (one per inserted/updated row; skipped rows\n// return nothing). On the empty-batch path the aggregate wraps the P02 result instead - filtered out below.\nconst cfg = $('Config').first().json;\nconst fetched = $('Fetch source (P02)').first().json.data || [];        // every row the API returned this run\nconst results = ($input.first().json.data || []).filter(r => r && r.id !== undefined && r.inserted !== undefined);\nconst inserted = results.filter(r => r.inserted === true).length;\nconst prev = String($('Read watermark').first().json.cursor || cfg.epoch);\nconst newest = fetched.map(r => String(r.updated_at || '')).filter(Boolean).sort().pop() || prev;\nreturn [{ json: {\n  source: cfg.source,\n  previous_cursor: prev,\n  cursor: newest > prev ? newest : prev,       // ISO-8601 Z strings compare lexicographically\n  fetched: fetched.length,\n  inserted,\n  updated: results.length - inserted,\n  skipped: fetched.length - results.length,    // hash equal -> no write\n  changed_ids: results.map(r => r.id),\n  last_run_at: new Date().toISOString(),\n} }];"
      },
      "id": "7b968a86-5173-568e-8566-728c328a513b",
      "name": "Sync summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        0
      ]
    },
    {
      "parameters": {
        "operation": "upsert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "sync_state",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "source": "={{ $json.source }}",
            "cursor": "={{ $json.cursor }}",
            "last_run_at": "={{ $json.last_run_at }}",
            "rows_seen": "={{ $json.fetched }}"
          },
          "matchingColumns": [
            "source"
          ],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "7e09614c-ef89-5f7f-8681-4b5fb8157498",
      "name": "Advance watermark",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        3380,
        0
      ],
      "notes": "Moves only after every changed row was written; re-run after a crash re-reads the same window (idempotent).",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "postgres": {
          "id": "ALcredPostgresDm",
          "name": "Postgres - demo"
        }
      }
    },
    {
      "parameters": {
        "content": "## D04 - Incremental sync (hash-based change detection)\nWatermark lives in `sync_state` (`mock-api-products`, cursor = max `updated_at` seen). Each run:\n\n1. `GET /products?updated_at_gte=<cursor>` through **P02** (backoff)\n2. canonical JSON of `{sku, name, price, stock}` -> SHA-256 `content_hash`\n3. `INSERT ... ON CONFLICT (id) DO UPDATE ... WHERE content_hash IS DISTINCT FROM EXCLUDED.content_hash` into `products_mirror` - unchanged rows write nothing (**P03**: the upsert *is* the idempotency guard)\n4. summary `{fetched, inserted, updated, skipped}` -> watermark advances **after** the writes\n\nSecond run = no-op (0 inserted, 0 updated). Reset: `test/reset-watermark.sh`.",
        "height": 270,
        "width": 700,
        "color": 4
      },
      "id": "4d31ff7b-de82-5489-abf8-1a3bc5cea383",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -360
      ]
    }
  ],
