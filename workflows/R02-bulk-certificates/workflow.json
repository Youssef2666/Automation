      "id": "9a9d485a-251c-5fe9-bd3f-2a3619e071f3",
      "name": "Extract rows",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        780,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Per row: {full_name, email, course, completed_on, hours, instructor} -> HTML certificate (A4 landscape).\nconst r = $json;\nconst slug = String(r.full_name || 'attendee').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');\nconst id = `CERT-${String(r.completed_on || '').replace(/-/g, '')}-${String($itemIndex + 1).padStart(3, '0')}`;\nconst html = `<!doctype html><html><head><meta charset=\"utf-8\"><style>\n@page { size: A4 landscape; margin: 0 }\nhtml,body{margin:0;width:297mm;height:210mm;font-family:'DejaVu Sans',sans-serif;color:#1d2b3a}\n/* explicit offsets: WeasyPrint 62 does not support the inset shorthand */\n.frame{position:absolute;top:14mm;left:14mm;right:14mm;bottom:14mm;border:6px double #b08d2c;padding:14mm 18mm;text-align:center}\nh1{font-size:34pt;letter-spacing:4px;margin:0 0 6mm;color:#b08d2c} .sub{font-size:13pt;color:#666}\n.name{font-size:30pt;margin:10mm 0 4mm;border-bottom:2px solid #1d2b3a;display:inline-block;padding:0 12mm 2mm}\n.course{font-size:18pt;margin:6mm 0} .meta{font-size:11pt;color:#555;margin-top:12mm}\n.sig{display:flex;justify-content:space-around;margin-top:16mm;font-size:11pt}\n.sig div{border-top:1px solid #1d2b3a;padding-top:2mm;width:60mm} .id{position:absolute;bottom:8mm;right:12mm;font-size:8pt;color:#999}\n</style></head><body><div class=\"frame\">\n<h1>CERTIFICATE</h1><div class=\"sub\">of completion</div>\n<div class=\"sub\" style=\"margin-top:8mm\">This certifies that</div>\n<div class=\"name\">${r.full_name}</div>\n<div class=\"sub\">has successfully completed</div>\n<div class=\"course\">${r.course}</div>\n<div class=\"meta\">${r.hours} hours · completed on ${r.completed_on}</div>\n<div class=\"sig\"><div>${r.instructor}<br><small>Instructor</small></div><div>Automation Lab Academy<br><small>Programme director</small></div></div>\n<div class=\"id\">${id} · synthetic demo document (R02)</div>\n</div></body></html>`;\nreturn { json: { ...r, certificate_id: id, filename: `${slug}-${String(r.course || '').toLowerCase().replace(/[^a-z0-9]+/g, '-')}.pdf`, html } };",
        "mode": "runOnceForEachItem"
      },
      "id": "62fd9bd0-c139-51f4-bcb4-44ca0fb77a11",
      "name": "Certificate HTML (per row)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://docgen:8090/render/pdf",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          },
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 2,
              "batchInterval": 200
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ html: $json.html, filename: $json.filename }) }}"
      },
      "id": "311ce0a0-a1fb-52cd-864c-83ee3dad92a4",
      "name": "Render PDF (docgen)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/home/node/.n8n-files/data/out/certificate-{{ $('Certificate HTML (per row)').item.json.filename }}",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "243ba739-1155-5c20-8a0d-bac347f261be",
      "name": "Write each PDF",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1560,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Collect every rendered PDF (binary \"data\" on each item) into ONE item with binary file0..fileN,\n// so the Compression node can zip them together.\nconst items = $input.all();\nconst binary = {};\nitems.forEach((it, i) => { if (it.binary && it.binary.data) binary[`file${i}`] = it.binary.data; });\nconst names = items.map(it => it.binary?.data?.fileName || `certificate-${it.json.certificate_id}.pdf`);\nreturn [{ json: { count: Object.keys(binary).length, files: names, keys: Object.keys(binary).join(','),\n                  zip_name: `certificates-${$now.toFormat('yyyyLLdd-HHmmss')}.zip` }, binary }];"
      },
      "id": "ed8ab58b-3ad6-5896-9c4d-5cea9e6a3898",
      "name": "Bundle PDFs into one item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        0
      ]
    },
    {
      "parameters": {
        "operation": "compress",
        "binaryPropertyName": "={{ $json.keys }}",
        "outputFormat": "zip",
        "fileName": "={{ $json.zip_name }}"
      },
      "id": "48649675-d64b-5ee8-8cb3-c08bb33aa1d8",
      "name": "Zip certificates",
      "type": "n8n-nodes-base.compression",
      "typeVersion": 1.1,
      "position": [
        2080,
        0
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/home/node/.n8n-files/data/out/{{ $('Bundle PDFs into one item').item.json.zip_name }}",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "335fb3cf-3c01-5a6a-8434-dfcf4f2971a8",
      "name": "Write ZIP",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        2340,
        0
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "bucketName": "reports",
        "fileName": "=certificates/{{ $('Bundle PDFs into one item').item.json.zip_name }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": {},
        "tagsUi": {}
      },
      "id": "ce99f7a8-1d20-59bb-81e7-04fd4a986cc6",
