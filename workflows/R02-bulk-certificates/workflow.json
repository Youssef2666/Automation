            "meta": "={{ JSON.stringify({ count: $('Bundle PDFs into one item').item.json.count, files: $('Bundle PDFs into one item').item.json.files }) }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "c89bf24e-d93b-5f92-bfe2-9ee267426916",
      "name": "Record document",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2860,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "ALcredPostgresDm",
          "name": "Postgres - demo"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "automation-lab@lab.local",
        "toEmail": "={{ $('Config').item.json.report_to }}",
        "subject": "=[Automation Lab] {{ $('Bundle PDFs into one item').item.json.count }} certificates generated",
        "options": {
          "attachments": "data"
        },
        "emailFormat": "html",
        "html": "=<p>{{ $('Bundle PDFs into one item').item.json.count }} certificates rendered from <code>{{ $('Config').item.json.file }}</code>; ZIP attached and stored in MinIO (reports/certificates/).</p><ul>{{ $('Bundle PDFs into one item').item.json.files.map(f => '<li>' + f + '</li>').join('') }}</ul>"
      },
      "id": "4dc59f80-9c68-549c-8b24-9750bec3c7e8",
      "name": "Email bundle (Mailpit)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2600,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "smtp": {
          "id": "ALcredSmtpMailpt",
          "name": "SMTP - Mailpit"
        }
      }
    },
    {
      "parameters": {
        "content": "## R02 - Bulk certificates from CSV\nEach CSV row becomes an HTML certificate (Code, per item) rendered by **docgen** `/render/pdf` (batched 2 at a time). PDFs are written individually, then bundled into one item and zipped (Compression node), stored in `data/out/` and MinIO `reports/certificates/`, logged in `documents` and e-mailed.\n\nSwap the CSV for a Postgres query or a form (T05) to drive it from live data.",
        "height": 220,
        "width": 640,
        "color": 4
      },
      "id": "4d49a083-3847-5116-b81d-5dbbcd388534",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -330
      ]
    }
  ],
