      "id": "387a1252-8c0c-5740-9a58-6f450955bc8e",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        0
      ],
      "notes": "Point `catalog_url` at any site whose product cards match the selectors in `Extract cards` / `Extract card fields`; `max_pages` caps a runaway rel=next chain.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// First turn: the input is the Config item (no page yet). Later turns: the parsed page carrying the rows so far.\nconst prev = $input.first().json;\nconst cfg = $('Config').first().json;\nconst page = prev.page ? Number(prev.page) + 1 : 1;\nreturn [{ json: { page, url: cfg.catalog_url, rows_so_far: prev.rows || [],\n                  key: cfg.gate_key, limit: cfg.gate_limit, window_seconds: cfg.gate_window_seconds } }];"
      },
      "id": "11fb90c5-1778-5e54-915e-cc913c4930b5",
      "name": "Next page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const page = Number($json.page || 1);\nconst card = (sku, name, cat, price, cur, stock) => `\n      <article class=\"product\" data-sku=\"${sku}\">\n        <h3 class=\"name\">${name}</h3>\n        <span class=\"category\">${cat}</span>\n        ${price === null ? '' : `<span class=\"price\" data-currency=\"${cur}\">${price}</span>`}\n        <span class=\"stock\">${stock}</span>\n      </article>`;\nconst pages = {\n  1: [card('SKU-9001', 'Fixture Desk Lamp', 'Office', '39.90', 'USD', '12 in stock'),\n      card('SKU-9002', 'Fixture Notebook (no price)', 'Stationery', null, 'USD', '5 in stock'),\n      card('SKU-BAD', 'Fixture Kettle', 'Kitchen', '24.00', 'USD', 'ships soon')],\n  2: [card('SKU-9001', 'Fixture Desk Lamp (duplicate)', 'Office', '39.90', 'USD', '12 in stock'),\n      card('SKU-9003', 'Fixture Camp Stove', 'Outdoor', '58.50', 'USD', 'out of stock')],\n};\nconst cards = pages[page] || [];\nconst next = page < 2 ? `<a rel=\"next\" href=\"/catalog?page=${page + 1}\">Next</a>` : '';\nconst html = `<!doctype html><html><body><main id=\"catalog\" data-page=\"${page}\" data-pages=\"2\">\n  <h1>Fixture catalog</h1>${cards.join('\\n')}\n  <nav class=\"pagination\"><span class=\"page\">Page ${page} of 2</span>${next}</nav>\n</main></body></html>`;\nreturn [{ json: { ok: true, status: 200, attempts: 1, data: html, url: `fixture://catalog?page=${page}` } }];"
      },
      "id": "ef55d71f-76fe-58f6-8a3f-ced7193a3eaa",
      "name": "Fixture page (no network)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ]
    },
