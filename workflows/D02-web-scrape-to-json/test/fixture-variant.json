      "id": "fe7590c2-59b1-5c1a-9e25-c3dc4427f8ed",
      "name": "Upload to MinIO (artifacts)",
      "type": "n8n-nodes-base.s3",
      "typeVersion": 1,
      "position": [
        3900,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "s3": {
          "id": "ALcredS3MinioLoc",
          "name": "S3 - MinIO"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Runs once after the upload. Counts come from the Rows node (valid and rejected); the reject branch runs after\n// this node (v1 order executes branches depth-first), so it is not referenced here.\nconst cfg = $('Config').first().json;\nconst all = $('Rows').all().map(i => i.json);\nconst rejected = all.filter(r => !r._valid);\nconst last = $('More pages?').last().json;\nreturn [{ json: {\n  source: cfg.catalog_url,\n  pages: Number(last.page || 0),\n  cards: all.length,\n  valid: all.length - rejected.length,\n  rejected: rejected.length,\n  reject_errors: rejected.map(r => `page ${r.page} card ${r.card} (${r.sku || 'no sku'}): ${r._errors}`),\n  file_name: cfg.file_name,\n  storage_key: `s3://${cfg.bucket}/${cfg.s3_key}`,\n  local_file: cfg.out_file,\n  rejects_file: rejected.length ? cfg.rejects_file : null,\n  run_at: new Date().toISOString(),\n} }];"
      },
      "id": "ac178701-7937-5977-b621-6c2abeef83f7",
      "name": "Summarize run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
