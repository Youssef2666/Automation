      "id": "706e6c00-a107-5097-8ed4-b653fc979332",
      "name": "One item per card",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        1560,
        0
      ]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "json",
        "dataPropertyName": "cards",
        "extractionValues": {
          "values": [
            {
              "key": "name",
              "cssSelector": ".name",
              "returnValue": "text",
              "returnArray": false
            },
            {
              "key": "category",
              "cssSelector": ".category",
              "returnValue": "text",
              "returnArray": false
