    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a4c9e056-9742-5eb0-a98b-21eb910c1d16",
              "leftValue": "={{ $json.has_next }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "dfe10002-d9f0-5668-bc2a-3d929918c471",
      "name": "More pages?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2340,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// All pages collected: one item per product card, valid or not.\nconst rows = $input.first().json.rows || [];\n// Zero cards is a failure, not an empty dataset: the markup changed or the site is down. Fail loudly so P01 records it.\nif (!rows.length) throw new Error('D02: no product cards matched the selectors (article.product) - markup changed?');\nreturn rows.map(r => ({ json: r }));"
      },
      "id": "d6060f55-752f-5a8e-ba2c-36c154c5e023",
      "name": "Rows",
