        },
        "options": {}
      },
      "id": "d3bf2cfc-711c-5204-8892-6e0ce1d2c1ad",
      "name": "Row valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2860,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Drop the validation bookkeeping; what is left is the published row schema.\nconst { _valid, _errors, ...row } = $input.item.json;\nreturn { json: row };",
        "mode": "runOnceForEachItem"
      },
      "id": "3b2a6c29-557d-55aa-88fc-a13b3055651e",
