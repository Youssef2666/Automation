      "name": "Upsert customers",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1820,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "postgres": {
          "id": "ALcredPostgresDm",
          "name": "Postgres - demo"
        }
      }
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "data",
        "options": {}
      },
      "id": "5df40ef9-5926-5d63-8ebe-745bb06af5b3",
      "name": "Collect imported",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        2080,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Runs once after the valid rows were upserted. Counts come from the validator; the reject branch runs\n// after this node (n8n v1 order executes branches depth-first), so it is not referenced here.\nconst all = $('Validate rows').all().map(i => i.json);\nconst rejected = all.filter(r => !r._valid);\nreturn [{ json: {\n  file: $('Config').first().json.file,\n  rows: all.length,\n  imported: all.length - rejected.length,\n  rejected: rejected.length,\n  reject_rows: rejected.map(r => r._row),\n  reject_errors: rejected.map(r => `row ${r._row}: ${r._errors}`),\n  reject_file: rejected.length ? 'data/out/rejects-<timestamp>.csv (written on the reject branch)' : null,\n}}];"
      },
      "id": "c15cabd5-e109-5259-91aa-47e738791216",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2340,
        0
      ]
    },
