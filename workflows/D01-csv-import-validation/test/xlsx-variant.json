          "mappingMode": "defineBelow",
          "value": {
            "external_id": "={{ $json.external_id }}",
            "name": "={{ $json.name }}",
            "email": "={{ $json.email }}",
            "phone": "={{ $json.phone }}",
            "company": "={{ $json.company }}",
            "country": "={{ $json.country }}",
            "city": "={{ $json.city }}",
            "segment": "={{ $json.segment || 'smb' }}"
          },
          "matchingColumns": [
            "external_id"
          ],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
