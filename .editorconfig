# EditorConfig - https://editorconfig.org (keep in sync with .gitattributes: LF everywhere)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.sh]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab

[*.{png,jpg,gif,pdf,xlsx,wav,ttf,zip}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
