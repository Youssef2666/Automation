# Normalise line endings; shell scripts and container init files must stay LF even on Windows checkouts.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile text eol=lf

# binaries
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.wav binary
*.ttf binary
*.zip binary
