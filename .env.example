# Automation Lab - example environment. Copy to .env (git-ignored). Every value here is a dummy for local use only.
# ---------------------------------------------------------------------------------------------------------------
# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
# leave empty to let n8n generate one on first start (stored in the n8n_data volume). Set a long random string for a stable key.
N8N_ENCRYPTION_KEY=
N8N_OWNER_EMAIL=owner@lab.local
N8N_OWNER_PASSWORD=LabOwner2026x
N8N_OWNER_FIRST_NAME=Lab
N8N_OWNER_LAST_NAME=Owner
GENERIC_TIMEZONE=Africa/Tripoli
TZ=Africa/Tripoli
# regular | queue  (queue needs: docker compose --profile core --profile queue up -d)
EXECUTIONS_MODE=regular
N8N_LOG_LEVEL=info

# Postgres (n8n's own database + the demo database used by the workflows)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_local_pw
POSTGRES_DB=n8n
DEMO_DB=demo

# Redis (queue mode, P02 rate limiting, caches)
REDIS_HOST=redis
REDIS_PORT=6379

# Mail: Mailpit catches outgoing mail (UI http://localhost:8025), GreenMail serves IMAP (T04 / B03)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=lab@lab.local
IMAP_HOST=greenmail
IMAP_PORT=3143
IMAP_USER=inbox@lab.local
IMAP_PASSWORD=inbox

# MinIO (S3-compatible, console http://localhost:9001)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_BACKUPS=backups
MINIO_BUCKET_ARTIFACTS=artifacts
MINIO_BUCKET_REPORTS=reports

# AI profile (docker compose --profile ai up -d) - all local, no key needed
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
QDRANT_URL=http://qdrant:6333
WHISPER_MODEL=base

# Shared secret for header-authenticated webhooks (T01/T02). Dummy value - change it for anything beyond local use.
LAB_WEBHOOK_KEY=lab-demo-key

# Optional external variants - leave empty; the core path never needs them
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GITHUB_TOKEN=
GITHUB_REPO=

# Observability profile
METABASE_PORT=3001
