      "id": "d9886a70-0f2d-515d-8c09-b5794bc60025",
      "name": "GET /ratelimited (gated)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2340,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const gated = $input.all().map(i => i.json);\nconst raw = $('Count 429s (no gate)').first().json;\nconst gated_429 = gated.filter(r => r.statusCode === 429).length;\n// $('Node').all() after a loop only returns the latest run; walk the run indexes to count every throttle.\nlet throttled = 0;\nfor (let r = 0; r < 100; r++) {\n  let items;\n  try { items = $('Rate limit gate (P04)').all(0, r); } catch (e) { break; }\n  if (!items || !items.length) break;\n  throttled += items.filter(i => i.json.allowed === false).length;\n}\nreturn [{ json: {\n  ungated: { requests: raw.ungated_requests, ok: raw.ungated_ok, status_429: raw.ungated_429 },\n  gated: { requests: gated.length, ok: gated.filter(r => r.statusCode === 200).length, status_429: gated_429,\n           throttled_by_gate: throttled },\n  pass: raw.ungated_429 > 0 && gated_429 === 0,\n  response: `without gate: ${raw.ungated_429}/${raw.ungated_requests} got 429; with gate: ${gated_429}/${gated.length} got 429`,\n}}];"
      },
      "id": "394afb3f-3ea2-511d-9314-7272b2c3ebbf",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        220
